# Copy to .env in the folder that needs it. Real values are shared privately, never committed.

# Jira REST access, per person: your own API token from
# id.atlassian.com > Security > Create API token. Lets an agent create and
# update tickets when the MCP route is not set up. Never commit the token.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=REC

DATABASE_URL=postgresql://user:password@host:5432/recon
REDIS_URL=rediss://default:password@host:6379

# web
JWT_SECRET=change-me
ASSET_STORAGE=disk            # disk, decided in FTW-13; see docs/STACK.md
ASSET_DIR=./storage

# Application level envelope encryption for assets (handbook Section 08,
# option 3 of the three things called "encryption at rest").
#   on  = asset bytes are AES-256-GCM encrypted before they touch disk
#   off = written as plaintext
# The code default when unset is off, so an existing checkout keeps working;
# this template ships `on` because that is the state the project claims.
# Switching it on is safe with files already on disk: encrypted files carry a
# magic prefix, so plaintext ones are still served correctly.
ASSET_ENCRYPTION=on
# 32 bytes, hex or base64. Generate with:  openssl rand -hex 32
# Never commit the real value. If encryption is on and this is missing or the
# wrong length, writes throw rather than silently falling back to plaintext.
ASSET_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Shared secret the GPU workers send as X-Worker-Token on /api/jobs/* .
# Separate from user JWTs on purpose: a leaked worker token must not be
# replayable against investigator-facing routes.
WORKER_TOKEN=

# gpu worker
WEB_API_URL=http://localhost:3000
WORKER_NAME=legion            # legion | desktop | victus
