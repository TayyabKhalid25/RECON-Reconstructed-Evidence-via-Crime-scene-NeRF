# Unity Smart Merge. Scenes, prefabs and .asset files are YAML that git's line merge
# cannot resolve; UnityYAMLMerge merges them by object id instead.
#
# One-time setup per developer (Windows path shown; adjust the Editor version):
#   git config merge.unityyamlmerge.name "Unity SmartMerge (UnityYAMLMerge)"
#   git config merge.unityyamlmerge.driver "\"C:/Program Files/Unity/Hub/Editor/6000.3.22f1/Editor/Data/Tools/UnityYAMLMerge.exe\" merge -p %O %B %A %A"
#   git config merge.unityyamlmerge.recursive binary
#
# Deliberately no LFS filters: large binaries do not enter git at all (AGENTS.md).
# Every tracked Unity YAML file is LF today, so eol=lf changes nothing on disk.

*.unity              merge=unityyamlmerge eol=lf
*.prefab             merge=unityyamlmerge eol=lf
*.asset              merge=unityyamlmerge eol=lf
*.mat                merge=unityyamlmerge eol=lf
*.anim               merge=unityyamlmerge eol=lf
*.controller         merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial     merge=unityyamlmerge eol=lf
*.playable           merge=unityyamlmerge eol=lf
*.mask               merge=unityyamlmerge eol=lf
*.spriteatlas        merge=unityyamlmerge eol=lf
*.shadervariants     merge=unityyamlmerge eol=lf
*.meta               merge=unityyamlmerge eol=lf

*.cs                 text eol=lf diff=csharp
*.asmdef             text eol=lf
*.json               text eol=lf
*.shader             text eol=lf
*.hlsl               text eol=lf
*.compute            text eol=lf

*.png                binary
*.jpg                binary
*.tif                binary
*.ttf                binary
*.otf                binary
*.fbx                binary
*.wav                binary
*.mp3                binary
*.dll                binary
*.so                 binary
*.aar                binary
*.jar                binary
