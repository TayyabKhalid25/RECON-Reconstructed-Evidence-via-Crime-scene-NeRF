# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Real values never get committed; examples must not be swept up by
# the wildcard, or a shared example silently fails to appear in a diff.
.env*
!.env.example

# uploads and produced assets: storage is disk plus tunnel (FTW-13), and .ply
# files are large binaries that must never enter git
/storage

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
